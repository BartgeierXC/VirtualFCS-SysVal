within VirtualFCS;

package UsersGuide "User information for the VirtualFCS-SysVal library"
  extends Modelica.Icons.Information;
  annotation(
    Documentation(info = "<html><head></head><body><p style=\"font-size: 12px;\">This is VirtualFCS-SysVal 2.1.0-sysval, a version of the open-source Modelica library <code>VirtualFCS</code> extended for the system-level simulation of a PEM fuel cell system on a test bench. It is the model of the accompanying publication. The measurement data of the publication are published in a Zenodo record, the evaluation code is FCSysVal (<a href=\"https://github.com/BartgeierXC/FCSysVal\">https://github.com/BartgeierXC/FCSysVal</a>). It is not an official VirtualFCS release.</p><p style=\"font-size: 12px;\">VirtualFCS was developed in the research project Virtual-FCS, funded by the European Union (see Acknowledgements). The source code of the upstream library is hosted on GitHub (<a href=\"https://github.com/Virtual-FCS\">https://github.com/Virtual-FCS</a>). Its issue tracker and contribution guidelines refer to the upstream library, not to VirtualFCS-SysVal.</p><p style=\"font-size: 12px;\">Dedicated User Guides for the main sub-packages are listed below and accessible via hyperlink.</p>

<div><br><table border=\"1\"><tbody><tr><th>Name</th>
            <th>Description</th>
         </tr>
         <tr>
            <td><a href=\"modelica://VirtualFCS.Electrochemical.UsersGuide\">Electrochemical</a></td>
            <td>Electrochemical energy storage and conversion devices.</td>
         </tr>
         
         <tr>
            <td><a href=\"modelica://VirtualFCS.Fluid.UsersGuide\">Fluid</a></td>
            <td>Fluid components supplementing the Modelica Standard Library.</td>
         </tr>
         
         <tr>
            <td><a href=\"modelica://VirtualFCS.Thermal.UsersGuide\">Thermal</a></td>
            <td>Thermal components supplementing the Modelica Standards Library.</td>
         </tr>
         
         <tr>
            <td><a href=\"modelica://VirtualFCS.SubSystems.UsersGuide\">SubSystems</a></td>
            <td>Encapsulated support subsystems for modelling fuel cell systems.</td>
         </tr>
         
      </tbody></table>

</div></body></html>"));
end UsersGuide;