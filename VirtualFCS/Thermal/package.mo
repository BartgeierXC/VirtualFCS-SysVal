within VirtualFCS;

package Thermal "Thermal components supplementing the Modelica Standards Library."
  extends Modelica.Icons.Package;
  annotation(
    Documentation(info = "<html><head></head><body>
<p>Thermal components of the VirtualFCS library that supplement the Modelica Standard Library:</p>
<ul>
<li><a href=\"modelica://VirtualFCS.Thermal.HeatExchanger\">HeatExchanger</a>: single-fluid heat exchanger between a fluid stream and a uniform-temperature thermal mass (closed-form NTU solution).</li>
</ul>
</body></html>"));
end Thermal;
