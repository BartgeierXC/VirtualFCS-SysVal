within VirtualFCS.SubSystems;

package Cooling "Subsystems related to the cooling line."
  extends Modelica.Icons.VariantsPackage;
  annotation(
    Documentation(info = "<html><head></head><body>
<p>Cooling subsystems: <a href=\"modelica://VirtualFCS.SubSystems.Cooling.SubSystemCoolingTST\">SubSystemCoolingTST</a> with a heat exchanger to a test-stand house coolant circuit and <a href=\"modelica://VirtualFCS.SubSystems.Cooling.SubSystemCoolingFix\">SubSystemCoolingFix</a> with a prescribed coolant supply temperature (open loop).</p>
</body></html>"));
end Cooling;
