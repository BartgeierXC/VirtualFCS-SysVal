within VirtualFCS;

package Electrochemical "Electrochemical energy storage and conversion devices."
  extends Modelica.Icons.Package;
  annotation(
    Documentation(info = "<html><head></head><body>
<p>Electrochemical energy conversion devices. The sub-package
<a href=\"modelica://VirtualFCS.Electrochemical.Hydrogen\">Hydrogen</a> contains the PEM fuel cell stack
(<a href=\"modelica://VirtualFCS.Electrochemical.Hydrogen.FuelCellStack\">FuelCellStack</a>), its algebraic cell-voltage model
(<a href=\"modelica://VirtualFCS.Electrochemical.Hydrogen.calculate_cell_voltage\">calculate_cell_voltage</a>) and the fuel cell
system with balance of plant (<a href=\"modelica://VirtualFCS.Electrochemical.Hydrogen.FuelCellSystem\">FuelCellSystem</a>).</p>
</body></html>"));
end Electrochemical;
