within VirtualFCS;

package Utilities "Supporting utilities and data."
  extends Modelica.Icons.UtilitiesPackage;
  annotation(
    Documentation(info = "<html><head></head><body>
<p>Supporting utilities:</p>
<ul>
<li><a href=\"modelica://VirtualFCS.Utilities.SystemControl\">SystemControl</a>: operating-point input (OpCons table) for the subsystems.</li>
<li><a href=\"modelica://VirtualFCS.Utilities.Poly2D\">Poly2D</a>: two-input polynomial block used for component maps.</li>
<li><a href=\"modelica://VirtualFCS.Utilities.CalcPulsedMean\">CalcPulsedMean</a>: mean of a pulsed signal over its active periods.</li>
<li><a href=\"modelica://VirtualFCS.Utilities.ReadTextTableSize\">ReadTextTableSize</a>: reads the dimensions of a Modelica text table.</li>
<li><a href=\"modelica://VirtualFCS.Utilities.Types\">Types</a>: enumerations for model options.</li>
<li><a href=\"modelica://VirtualFCS.Utilities.Volume_standard_litre_flow_rate\">Volume_standard_litre_flow_rate</a>: volume flow type in standard litres per minute.</li>
</ul>
</body></html>"));
end Utilities;
